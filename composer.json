{
  "name": "betterlite/yamada",
  "description": "API library for creating Minigames on PocketMine 5",
  "type": "library",
  "keywords": ["pocketmine", "pocketmine-mp", "minigame", "api", "virion"],
  "license": "MIT",
  "version": "0.2.0",
  "authors": [
    {
      "name": "BetterLite",
      "homepage": "https://github.com/BetterLite"
    }
  ],
  "support": {
    "issues": "https://github.com/BetterLite/Yamada/issues",
    "source": "https://github.com/BetterLite/Yamada"
  },
  "require": {
    "php": "^8.1",
    "pocketmine/pocketmine-mp": "^5.0.0"
  },
  "require-dev": {
    "pocketmine/php-src": "*",
  },
  "autoload": {
    "psr-4": {
      "betterlite\\yamada\\": "src/betterlite/yamada/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "betterlite\\yamada\\tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit tests/"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}